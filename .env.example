# --- Database (local Postgres, db name: bidkaroindia) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bidkaroindia?schema=public"

# --- NextAuth (admin login only — Google) ---
# NEXTAUTH_SECRET also keys the HMAC signature on the anonymous bidder
# identity cookie (src/lib/anonSession.ts), so it's required even though
# regular visitors never see a NextAuth screen.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth — used only to reach /admin. Leave blank to disable admin login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments ---
# No real gateway is wired yet (per current build scope). The provider
# interface in src/lib/payments is ready to plug in Razorpay for the
# Vercel + Supabase + Razorpay production target.
PAYMENTS_PROVIDER="simulated"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="bidkaroindia.lol"

# --- Realtime (Supabase) ---
# Powers the live activity feed (src/lib/eventBus.ts, src/hooks/useActivityFeed.ts).
# Leave blank to disable live activity broadcasting (bidding/leaderboards still work).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
