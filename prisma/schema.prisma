generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeaderboardStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EventType {
  ENTERED
  NEW_TOP
  MOVED
  OUTBID
}

enum NotificationType {
  OUTBID
  WELCOME
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String?
  avatarUrl     String?
  instagram     String?
  phone         String?   @unique
  email         String?   @unique
  city          String?
  isAdmin       Boolean   @default(false)
  isBanned      Boolean   @default(false)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bids            Bid[]
  payments        Payment[]
  notifications   Notification[]
  events          LeaderboardEvent[]
  referralsMade   Referral[]         @relation("referrer")
  referralsGot    Referral[]         @relation("referred")
  topLeaderboards Leaderboard[]      @relation("currentTopUser")
  auditLogs       AdminAuditLog[]

  @@index([username])
}

model Leaderboard {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  status          LeaderboardStatus @default(ACTIVE)
  minStartingBid  Int               @default(1)
  incrementConfig Json              @default("[{\"upTo\":999,\"increment\":1},{\"upTo\":9999,\"increment\":10},{\"upTo\":null,\"increment\":100}]")

  currentAmount   Int      @default(0)
  currentUserId   String?
  currentUser     User?    @relation("currentTopUser", fields: [currentUserId], references: [id])
  currentBidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids   Bid[]
  events LeaderboardEvent[]

  @@index([slug])
}

model Bid {
  id            String   @id @default(cuid())
  userId        String
  leaderboardId String
  amount        Int
  rankBefore    Int?
  rankAfter     Int?
  paymentId     String?  @unique
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])

  @@index([leaderboardId, amount])
  @@index([userId])
}

model Payment {
  id                 String        @id @default(cuid())
  userId             String
  leaderboardSlug    String
  provider           String
  providerOrderId    String?
  providerPaymentId  String?
  amount             Int
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  idempotencyKey     String        @unique
  verifiedAt         DateTime?
  createdAt          DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])
  bid  Bid?

  @@index([userId])
  @@index([providerOrderId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model Referral {
  id               String   @id @default(cuid())
  referrerUserId   String
  referredUserId   String
  source           String?
  createdAt        DateTime @default(now())

  referrer User @relation("referrer", fields: [referrerUserId], references: [id])
  referred User @relation("referred", fields: [referredUserId], references: [id])

  @@index([referrerUserId])
}

model LeaderboardEvent {
  id            String      @id @default(cuid())
  leaderboardId String
  userId        String
  eventType     EventType
  amount        Int
  metadata      Json?
  createdAt     DateTime    @default(now())

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([leaderboardId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
}
